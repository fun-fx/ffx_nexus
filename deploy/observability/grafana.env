# ============================================================================
# LOCAL DEVELOPMENT ONLY — NEVER DEPLOY THIS FILE
# ============================================================================
#
# Mounted read-only by the Nexus compose `observability` profile so that
# `docker compose up` gives a developer a working Grafana with no setup. The
# values below are deliberately insecure and would be a serious finding in a
# customer environment:
#
#   - admin/admin is the well-known Grafana default credential pair.
#   - anonymous access is ENABLED, so anyone who can reach the port reads every
#     dashboard without logging in. Nexus dashboards show per-org request volume
#     and cost, so in a real deployment that is a tenant data disclosure.
#
# Nexus does not deploy Grafana. The Helm chart has no Grafana credentials and no
# anonymous-access setting, by design: you connect your own Grafana, secured your
# way. Nothing in this file reaches a customer install, and nothing in it should
# be copied into one. See docs/customer-self-hosted-security.md.
#
# Real secrets do not belong here either. Local-only credentials live in `.env`,
# which is git-ignored.
# ============================================================================
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer

# Provisioned dashboards pick up dashboards.json from /var/lib/grafana/dashboards.
GF_PATHS_PROVISIONING=/etc/grafana/provisioning
