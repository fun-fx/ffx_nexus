{
  "annotations": {
    "list": []
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "title": "Nexus - 03 - Eval Quality",
  "tags": [
    "nexus",
    "eval"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Eval score (avg, last 24h)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm-default"
      },
      "targets": [
        {
          "expr": "avg_over_time(nexus_eval_quality_score[24h])",
          "refId": "A",
          "legendFormat": "avg"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.8
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Evaluations sampled (24h)",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm-default"
      },
      "targets": [
        {
          "expr": "sum(increase(nexus_eval_samples_total[24h]))",
          "refId": "A",
          "legendFormat": "samples"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Eval pass rate (24h)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm-default"
      },
      "targets": [
        {
          "expr": "sum(rate(nexus_eval_passed_total[24h])) / clamp_min(sum(rate(nexus_eval_passed_total[24h]) + rate(nexus_eval_failed_total[24h])), 1)",
          "refId": "A",
          "legendFormat": "passed/total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Quality score over time (by model)",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm-default"
      },
      "targets": [
        {
          "expr": "avg_over_time(nexus_eval_quality_score[5m])",
          "refId": "A",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Throughput (samples/min, by model)",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm-default"
      },
      "targets": [
        {
          "expr": "sum by (model) (rate(nexus_eval_samples_total[5m])) * 60",
          "refId": "A",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Pass vs fail (by metric)",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm-default"
      },
      "targets": [
        {
          "expr": "sum by (metric) (rate(nexus_eval_passed_total[5m]))",
          "refId": "A",
          "legendFormat": "{{metric}} (passed)"
        },
        {
          "expr": "sum by (metric) (rate(nexus_eval_failed_total[5m]))",
          "refId": "B",
          "legendFormat": "{{metric}} (failed)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5
          }
        }
      }
    }
  ],
  "uid": "nexus-03-eval-quality"
}
