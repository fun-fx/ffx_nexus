    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Spend (last 1h, USD)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm-default"
      },
      "targets": [
        {
          "expr": "sum(increase(nexus_gateway_spend_usd_total[1h]))",
          "refId": "A",
          "legendFormat": "spend"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Spend (last 24h, USD)",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm-default"
      },
      "targets": [
        {
          "expr": "sum(increase(nexus_gateway_spend_usd_total[24h]))",
          "refId": "A",
          "legendFormat": "spend"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Spend (last 7d, USD)",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm-default"
      },
      "targets": [
        {
          "expr": "sum(increase(nexus_gateway_spend_usd_total[7d]))",
          "refId": "A",
          "legendFormat": "spend"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Spend over time (USD, by provider)",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm-default"
      },
      "targets": [
        {
          "expr": "sum by (provider) (increase(nexus_gateway_spend_usd_total[5m]))",
          "refId": "A",
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Top 10 virtual keys by spend (24h)",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vm-default"
      },
      "targets": [
        {
          "expr": "topk(10, sum by (virtual_key_id) (increase(nexus_gateway_spend_usd_total{}[24h])))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "virtual_key_id": "vkey",
              "Value": "spend_usd"
            }
          }
        }
      ],
      "options": {
        "showHeader": true
      }
    }
